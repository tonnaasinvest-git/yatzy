generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model players {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String          @unique
  nickname      String
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  game_players  game_players[]
  game_sessions game_sessions[]
}

model game_players {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String?        @db.Uuid
  player_id     String?        @db.Uuid
  turn_order    Int
  cash_balance  Int?           @default(30000)
  is_active     Boolean?       @default(true)
  players       players?       @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  game_sessions game_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, player_id])
}

model game_sessions {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saved_state          Json?
  current_round        Int?            @default(1)
  active_player_index  Int?            @default(0)
  status               String?         @default("in_progress")
  winner_id            String?         @db.Uuid
  variant_topp_enabled Boolean?        @default(true)
  created_at           DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?       @default(now()) @db.Timestamptz(6)
  game_players         game_players[]
  players              players?        @relation(fields: [winner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
